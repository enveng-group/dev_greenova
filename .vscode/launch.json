{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Django: Runserver",
			"type": "python",
			"request": "launch",
			"program": "${workspaceFolder}/manage.py",
			"args": ["runserver", "0.0.0.0:8000"],
			"django": true,
			"env": {
				"DJANGO_SETTINGS_MODULE": "greenova.settings"
			},
			"console": "integratedTerminal",
			"justMyCode": true
		},
		{
			"name": "Python: Unit Tests",
			"type": "python",
			"request": "launch",
			"program": "${workspaceFolder}/manage.py",
			"args": ["test"],
			"django": true,
			"env": {
				"DJANGO_SETTINGS_MODULE": "greenova.settings"
			},
			"console": "integratedTerminal",
			"justMyCode": true
		}
	]
}
