      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run MyPy",
      "type": "shell",
      "command": "/usr/local/bin/mypy",
      "args": ["greenova/"],
      "options": {
        "cwd": "${env:WORKSPACE_ROOT}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Pre-commit",
      "type": "shell",
      "command": "/usr/local/bin/pre-commit",
      "args": ["run"],
      "options": {
        "cwd": "${env:WORKSPACE_ROOT}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Doit - Build All (Development)",
      "type": "shell",
      "command": "doit",
      "args": [
        "build_all_dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "Doit - Build All (Production)",
      "type": "shell",
      "command": "doit",
      "args": [
