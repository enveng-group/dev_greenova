{
  // See https://code.visualstudio.com/docs/editor/tasks for documentation
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Django Server (Gunicorn)",
      "type": "shell",
      "command": "/workspaces/greenova/scripts/run_gunicorn.py",
      "options": {
        "cwd": "${env:DJANGO_PROJECT_ROOT}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Django Server (Development)",
      "type": "shell",
      "command": "/workspaces/greenova/.venv/bin/python",
      "args": [
        "/workspaces/greenova/greenova/manage.py",
        "runserver",
        "0.0.0.0:8000"
