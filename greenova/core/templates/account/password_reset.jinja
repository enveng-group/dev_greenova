{% extends "core/base.jinja" %}
{% load django_bootstrap5 %}
{% block title %}Password Reset{% endblock %}
{% block content %}
<main class="container py-5">
  <section aria-labelledby="reset-heading" class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
      <div class="card" style="background: var(--greenova-background-secondary); border-color: var(--greenova-border-color);">
        <div class="card-body" style="padding: var(--greenova-padding-xlarge);">
          <h1 id="reset-heading" class="card-title text-center mb-4" style="color: var(--color-green-primary); font-weight: var(--greenova-font-weight-bold);">Reset Password</h1>
          <form method="post" action="{% url 'account_reset_password' %}" novalidate>
            {% csrf_token %}
            <div class="mb-3">
              <label for="id_email" class="form-label" style="color: var(--greenova-text-primary-dark); font-size: var(--greenova-input-label);">Email Address</label>
              <input type="email" name="email" id="id_email" class="form-control" required autocomplete="email" style="background: var(--greenova-input-bg); color: var(--greenova-input-color); border-color: var(--greenova-input-border);">
              <div class="invalid-feedback">Please enter a valid email address.</div>
            </div>
            {% bootstrap_button "Send Reset Link" button_type="submit" button_class="btn-primary" extra_classes="w-100" %}
          </form>
        </div>
      </div>
    </div>
  </section>
</main>
{% endblock %}
