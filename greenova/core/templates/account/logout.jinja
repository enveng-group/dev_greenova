{% extends "core/base.jinja" %}
{% load django_bootstrap5 %}
{% block title %}Sign Out{% endblock %}
{% block content %}
<main class="container py-5">
  <section aria-labelledby="logout-heading" class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
      <div class="card" style="background: var(--greenova-background-secondary); border-color: var(--greenova-border-color);">
        <div class="card-body text-center" style="padding: var(--greenova-padding-xlarge);">
          <h1 id="logout-heading" class="card-title mb-4" style="color: var(--color-green-primary); font-weight: var(--greenova-font-weight-bold);">Sign Out</h1>
          <form method="post" action="{{ url('account_logout') }}">
            {% csrf_token %}
            <p style="color: var(--greenova-text-secondary-dark); margin-bottom: var(--greenova-spacing-large);">Are you sure you want to sign out?</p>
            <div class="d-grid gap-2">
              {% bootstrap_button "Sign Out" button_type="submit" button_class="btn-danger" %}
              <a href="/" class="btn btn-secondary" style="background: var(--color-blue-primary); border-color: var(--color-blue-primary);">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</main>
{% endblock %}
