{% extends "core/base.jinja" %}
{% load django_bootstrap5 %}
{% block title %}Sign In{% endblock %}
{% block content %}
<main class="container py-5">
  <section aria-labelledby="signin-heading" class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
      <div class="card" style="background: var(--greenova-background-secondary); border-color: var(--greenova-border-color);">
        <div class="card-body" style="padding: var(--greenova-padding-xlarge);">
          <h1 id="signin-heading" class="card-title text-center mb-4" style="color: var(--color-green-primary); font-weight: var(--greenova-font-weight-bold);">Sign In</h1>
          <form method="post" action="/accounts/login/" novalidate>
            {% csrf_token %}
            <div class="mb-3">
              <label for="id_login" class="form-label" style="color: var(--greenova-text-primary-dark); font-size: var(--greenova-input-label);">Email or Username</label>
              <input type="text" name="login" id="id_login" class="form-control" required autofocus autocomplete="username" style="background: var(--greenova-input-bg); color: var(--greenova-input-color); border-color: var(--greenova-input-border);">
              <div class="invalid-feedback">Please enter your email or username.</div>
            </div>
            <div class="mb-3">
              <label for="id_password" class="form-label" style="color: var(--greenova-text-primary-dark); font-size: var(--greenova-input-label);">Password</label>
              <input type="password" name="password" id="id_password" class="form-control" required autocomplete="current-password" style="background: var(--greenova-input-bg); color: var(--greenova-input-color); border-color: var(--greenova-input-border);">
              <div class="invalid-feedback">Please enter your password.</div>
            </div>
            <div class="mb-3 form-check">
              <input type="checkbox" name="remember" id="id_remember" class="form-check-input">
              <label for="id_remember" class="form-check-label" style="color: var(--greenova-text-secondary-dark);">Remember me</label>
            </div>
            {% bootstrap_button "Sign In" button_type="submit" button_class="btn-primary" extra_classes="w-100" %}
          </form>
          <div class="text-center mt-3">
            <a href="{% url 'account_reset_password' %}" style="color: var(--color-blue-primary);">Forgot your password?</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
{% endblock %}
