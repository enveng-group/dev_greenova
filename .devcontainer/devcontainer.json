{
	"name": "Greenova Development Environment",
	"build": {
		"dockerfile": "./Containerfile",
		"context": "."
	},
	"features": {
		"./local-features/git": {},
		"./local-features/bash": {},
		"./local-features/node": {},
		"./local-features/python": {},
		"./local-features/dropbear": {},
		"./local-features/protoc": {},
		"./local-features/chromium": {},
		"./local-features/fish": {}
	},
	"mounts": [
		"source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
	],
	"remoteUser": "vscode",
	"onCreateCommand": ".devcontainer/scripts/on_create.sh",
	"postCreateCommand": ".devcontainer/scripts/post_create.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"GitHub.copilot",
				"GitHub.copilot-chat",
				"ms-python.python"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "fish",
				"terminal.integrated.profiles.linux": {
					"fish": {
						"path": "fish"
					}
				},
				"emmet.includeLanguages": {
					"django-html": "html"
				},
				"python.testing.nosetestsEnabled": false,
				"python.testing.djangoTestsEnabled": true,
				"python.testing.djangoTestsArgs": [
					"--keepdb",
					"--parallel",
					"auto",
					"--verbosity=2"
				],
				"python.testing.djangoSettingsModule": "greenova.settings",
				"python.linting.enabled": true,
				"python.linting.pylintEnabled": true,
				"python.linting.pylintPath": "/usr/local/bin/pylint",
				"python.linting.mypyEnabled": true,
				"python.linting.mypyPath": "/usr/local/bin/mypy",
				"python.linting.banditEnabled": true,
				"python.linting.banditPath": "/usr/local/bin/bandit",
				"python.formatting.provider": "black",
				"python.formatting.blackPath": "/usr/local/bin/black",
				"python.formatting.autopep8Path": "/usr/local/bin/autopep8",
				"python.sortImports.path": "/usr/local/bin/isort",
			}
		},
		"remoteEnv": {
			"PATH": "/workspaces/greenova/.venv/bin:${containerEnv:PATH}",
			"PYTHONPATH": "/workspaces/greenova"
		},
		"workspaceFolder": "/workspaces/greenova",
		"runArgs": [
			"--userns=keep-id"
		]
	}
