    "build:sass": "sass greenova/core/static/core/scss/main.scss:greenova/core/static/core/css/main.css --style=compressed --source-map && postcss greenova/core/static/core/css/main.css -o greenova/core/static/core/css/main.css",
    "build:sass:dev": "sass greenova/core/static/core/scss/main.scss:greenova/core/static/core/css/main.css --watch --source-map",
    "build:as-proto:copy": "mkdir -p greenova/core/static/core/as/assembly/as-proto/internal && cp node_modules/as-proto/assembly/*.ts greenova/core/static/core/as/assembly/as-proto/ && cp node_modules/as-proto/assembly/internal/*.ts greenova/core/static/core/as/assembly/as-proto/internal/",
    "build:wasm": "npm run build:as-proto:copy && npx asc greenova/core/static/core/as/assembly/index.ts --config greenova/core/static/core/as/asconfig.json --outFile greenova/core/static/core/as/build/release.wasm --optimize --sourceMap",
    "build:wasm:dev": "npm run build:as-proto:copy && npx asc greenova/core/static/core/as/assembly/index.ts --config greenova/core/static/core/as/asconfig.json --outFile greenova/core/static/core/as/build/debug.wasm --debug --sourceMap",
    "build:protos:copy": "mkdir -p greenova/core/static/core/as/proto && cp greenova/protobuf/*.proto greenova/core/static/core/as/proto/",
    "build:ts": "tsc -p greenova/core/static/core/ts/tsconfig.json",
    "build:frontend": "npm run build:protos:copy && npm run build:ts",
    "build:vendors": "echo 'Vendors build placeholder - vendors served via CDN or Django static files'",
    "build:critical": "critical --base greenova/core/static/core/ --src templates/base.html --css greenova/core/static/core/css/main.css --inline --minify --dest templates/base.critical.html",
    "build:all": "npm run build:sass && npm run build:wasm && npm run build:frontend && npm run build:vendors && npm run build:critical",
    "test:ts": "vitest run greenova/core/static/core/ts/**/*.spec.ts",
    "build:parcel:dev": "parcel build greenova/core/static/core/ts/index.html --dist-dir greenova/core/static/core/js/dist",
    "build:parcel:prod": "parcel build greenova/core/static/core/ts/index.html --dist-dir greenova/core/static/core/js/dist",
    "dev:parcel": "parcel serve greenova/core/static/core/ts/index.html --dist-dir greenova/core/static/core/js/dist --port 3000",
    "doit:build:dev": "doit build_all_dev",
